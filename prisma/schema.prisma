generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  discordUserId    String           @unique
  discordUsername  String
  leetcodeUsername String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  solvedProblems   SolvedProblem[]
  seenSubmissions  SeenSubmission[]

  @@index([leetcodeUsername])
}

model SolvedProblem {
  id                       String    @id @default(cuid())
  discordUserId            String
  problemSlug              String
  problemTitle             String
  difficulty               String?
  firstSolvedAt            DateTime
  lastResubmissionPostedAt DateTime?
  createdAt                DateTime  @default(now())
  user                     User      @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@unique([discordUserId, problemSlug])
  @@index([discordUserId])
  @@index([problemSlug])
}

model SeenSubmission {
  id            String   @id @default(cuid())
  submissionId  String   @unique
  discordUserId String
  problemSlug   String
  problemTitle  String
  status        String
  language      String?
  submittedAt   DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [discordUserId], references: [discordUserId], onDelete: Cascade)

  @@index([discordUserId])
  @@index([submittedAt])
  @@index([problemSlug])
}

model GuildConfig {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  postChannelId       String
  pollIntervalMinutes Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
